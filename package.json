{
  "name": "personavision",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A swarm of simulated users that produces Tobii-style eye tracking for websites",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.13.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r build && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --if-present dev",
    "seed:example-run": "tsx --conditions=development scripts/seed-example-run.ts",
    "open": "tsx packages/cli/src/cli.ts open"
  },
  "devDependencies": {
    "@personavision/contract": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
