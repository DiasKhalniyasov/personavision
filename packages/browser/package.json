{
  "name": "@personavision/browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser driving, screenshots and area-of-interest extraction",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "record:captures": "tsc -p tsconfig.record.json && node dist/record/scripts/record-captures.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@personavision/contract": "workspace:*",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
