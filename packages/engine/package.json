{
  "name": "@personavision/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The session engine that drives personas through a variant",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "fixtures": "tsx --conditions development scripts/make-fixtures.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@personavision/contract": "workspace:*",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
