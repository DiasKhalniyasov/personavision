{
  "name": "@personavision/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The personavision command line: serve, open, run and validate",
  "bin": {
    "personavision": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@personavision/contract": "workspace:*",
    "@personavision/platform": "workspace:*",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
