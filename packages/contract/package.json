{
  "name": "@personavision/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, inferred types and the run-directory layout for the run artifact",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
