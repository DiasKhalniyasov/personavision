{
  "name": "@personavision/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Accounts, sign-in sessions, workspaces, audience storage and the platform server behind personavision serve",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@personavision/contract": "workspace:*",
    "@personavision/personas": "workspace:*",
    "@personavision/provider": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
